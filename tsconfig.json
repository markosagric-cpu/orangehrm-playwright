{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@pages/*": ["./pages/*"],
      "@components/*": ["./components/*"]
    }
  },
  "include": ["tests/**/*.ts", "pages/**/*.ts", "components/**/*.ts", "playwright.config.ts"]
}